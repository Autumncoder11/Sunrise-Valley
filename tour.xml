	<scene name="scene_dji_20260530023817_0241_d" title="DJI_20260530023817_0241_D" onstart="gui_master_startup(); updateRoadLabels();" thumburl="panos/IMG_20260921_100207.tiles/thumb.jpg" lat="11.12801342" lng="77.00365839" alt="585.75" heading="0.0">
		
		<control bouncinglimits="calc:image.cube ? true : false" />

		<!-- maxpixelzoom is capped lower on mobile (via krpano's built-in
		     .mobile/.desktop attribute-suffix targeting) so less
		     high-resolution multires texture gets pulled into GPU memory
		     at once. The panorama's cube faces go up to 3328px, and that
		     memory pressure combined with the canvas resize on rotation
		     is the most likely reason mobile browsers have been
		     reloading the page. Desktop keeps the original 2.0. -->
		<!-- <view hlookat="6.629" vlookat="90.000" fovtype="MFOV" fov="140.000" maxpixelzoom.mobile="1.0" maxpixelzoom.desktop="2.0" fovmin="70" fovmax="140" limitview="auto" /> -->
		<view hlookat="6.629" vlookat="90.000" fovtype="MFOV" fov.mobile="142.000" fov.desktop="140.000" maxpixelzoom.mobile="1.0" maxpixelzoom.desktop="2.0" fovmin="70" fovmax.mobile="143" fovmax.desktop="140" limitview="auto" />

		<preview url="panos/IMG_20260921_100207.tiles/preview.jpg" />

		<image>
			<cube url="panos/IMG_20260921_100207.tiles/%s/l%l/%v/l%l_%s_%v_%h.jpg" multires.mobile="512,768,1664" multires.desktop="512,768,1664,3328" />
		</image>
		<events name="roadlabel_align" onviewchange="updateRoadLabels()" />
		<!-- Fires once the pano's actual image/tiles have finished loading and
		     are on screen (unlike onready in tour.html, which only means the
		     krpano viewer itself has initialized). Hides the HTML loading
		     overlay; see hideLoadingOverlay() in tour.html.
		     Also forces road-label-zoom.js to rescan for roadlabelN hotspots:
		     output_hotspots.xml (which defines them) loads asynchronously,
		     so road-label-zoom.js's very first scan can run before all of
		     them exist yet; any missed at that instant were never rescaled
		     from their placeholder 100px css, which is the giant-yellow-
		     letters bug. onloadcomplete guarantees everything has actually
		     finished loading, so the rescan here catches them. -->
		<events name="loading_events" onloadcomplete="js(hideLoadingOverlay()); js(window.roadLabelZoom &amp;&amp; window.roadLabelZoom.refresh()); js(window.plotPopup &amp;&amp; window.plotPopup.disableCaptureNow()); js(window.plotPopup &amp;&amp; window.plotPopup.restyleNow());" />

		<!-- <action name="flatten_plot_labels">
    	for(set(i,0), i LE 397, inc(i),
        txtadd(hsname, 'kml_label_', get(i));
        if(hotspot[get(hsname)],
            set(hotspot[get(hsname)].distorted, true);
            set(hotspot[get(hsname)].rx, calc(get(hotspot[get(hsname)].atv) - 90));
            set(hotspot[get(hsname)].ry, calc(0 - get(hotspot[get(hsname)].ath)));
        	);
    	);
		</action> -->
		<action name="updateRoadLabels">
			updateRoadLabel(roadlabel1);
			updateRoadLabel(roadlabel2);
			updateRoadLabel(roadlabel3);
			updateRoadLabel(roadlabel4);
			updateRoadLabel(roadlabel5);
			updateRoadLabel(roadlabel6);
			updateRoadLabel(roadlabel7);
			updateRoadLabel(roadlabel8);
			updateRoadLabel(roadlabel9);
			updateRoadLabel(roadlabel10);
			updateRoadLabel(roadlabel11);
			updateRoadLabel(roadlabel12);
			updateRoadLabel(roadlabel13);
			updateRoadLabel(roadlabel14);
			updateRoadLabel(roadlabel15);
			updateRoadLabel(roadlabel16);
			updateRoadLabel(roadlabel17);
			updateRoadLabel(roadlabel18);
		</action>

		<action name="updateRoadLabel">
			if(hotspot[%1] AND hotspot[%1].road_dir_ath != null,
				spheretoscreen(get(hotspot[%1].ath), get(hotspot[%1].atv), label_sx, label_sy);
				spheretoscreen(get(hotspot[%1].road_dir_ath), get(hotspot[%1].road_dir_atv), dir_sx, dir_sy);
				set(label_angle, calc(atan2(dir_sy - label_sy, dir_sx - label_sx) * 57.29577951308232));
				set(hotspot[%1].rotate, calc(label_angle));
				// font-size is intentionally fixed (basefontsize, set per-label in
				// output_hotspots.xml) and is no longer touched here. Every attempt
				// to scale it dynamically with fov/foreshortening either overflowed
				// or visibly stretched the text at certain angles -- a constant
				// size that was chosen to fit each road at design time is more
				// reliable than any runtime formula. Only rotation adapts live.
			);
		</action>
		<action name="set_all_label_rz">
    set(rzval, %1);
    for(set(i,0), i LE 397, inc(i),
        txtadd(hsname, 'kml_label_', get(i));
        if(hotspot[get(hsname)],
            set(hotspot[get(hsname)].rz, get(rzval));
        );
    );
</action>
