/* =========================================================================
   action-bar.css
   Horizontal row of icon pills fixed at the top of the tour: Filter,
   WhatsApp, Enquiry, Brochure, Call, Location. Visual language matches the
   provided mockup: white rounded pills, colored icon per action, bold dark
   label.
   ========================================================================= */

#plotActionBarRoot {
  position: fixed;
  top: 14px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 950;
  /* above the filter bar and pano, below the plot/enquiry popups */
  font-family: Arial, Helvetica, sans-serif;
  max-width: calc(100vw - 16px);
}

.plot-action-bar {
  display: flex;
  align-items: center;
  gap: 10px;
  overflow-x: auto;
  padding: 4px 2px;
  /* room for the pill shadow without clipping */
  -ms-overflow-style: none;
  scrollbar-width: none;
}

.plot-action-bar::-webkit-scrollbar {
  display: none;
}

.plot-action-pill {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 0 0 auto;
  background: #FFFFFF;
  color: #1a1a1a;
  border: none;
  border-radius: 999px;
  padding: 9px 18px 9px 10px;
  font-size: 14px;
  font-weight: bold;
  cursor: pointer;
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.25);
  white-space: nowrap;
  /* Smooths the padding/font-size change across the touch/width
     breakpoint and the landscape-specific rule below, instead of an
     abrupt snap mid-rotation. */
  transition: padding 0.15s ease, font-size 0.15s ease;
}

.plot-action-pill:hover {
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.32);
}

.plot-action-pill:active {
  transform: translateY(1px);
}

.plot-action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  flex: 0 0 auto;
}

.plot-action-icon svg {
  width: 20px;
  height: 20px;
}

/* Per-action accent colors, matching the mockup */
.plot-action-pill--filter .plot-action-icon svg {
  stroke: #333333;
}

.plot-action-pill--whatsapp .plot-action-icon svg {
  color: #22C55E;
}

.plot-action-pill--enquiry .plot-action-icon svg {
  color: #2563EB;
}

.plot-action-pill--brochure .plot-action-icon svg {
  color: #7C3AED;
}

.plot-action-pill--call .plot-action-icon svg {
  color: #F59E0B;
}

.plot-action-pill--location .plot-action-icon svg {
  color: #DB2777;
}

/* Highlight the Filter pill while its panel is open */
.plot-action-pill--filter.plot-action-pill--active {
  background: #1a1a1a;
  color: #FFFFFF;
}

.plot-action-pill--filter.plot-action-pill--active .plot-action-icon svg {
  stroke: #FFFFFF;
}

/* Small red match-count badge on the Filter pill after a search */
.plot-action-count-badge {
  display: none;
  align-items: center;
  justify-content: center;
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  border-radius: 999px;
  background: #E11D2E;
  color: #FFFFFF;
  font-size: 11px;
  font-weight: bold;
}

/* Gated on the html.is-touch-device class set once in index.html's <head>
   (touch capability at page load), not on (hover:none)/(pointer:coarse)
   or a width breakpoint. Both of those are re-evaluated live as the
   viewport changes, and on some mobile/in-app browsers they can
   misreport for a moment during a rotation animation -- with nothing
   left to fall back on once the landscape width exceeds any width
   threshold, the layout would snap back to the desktop padding. Touch
   capability itself never changes when the device rotates, so a class
   set once here can't flip back that way. */
html.is-touch-device .plot-action-pill {
  padding: 8px 14px 8px 8px;
  font-size: 13px;
}

/* Landscape phones have much less height to spare than portrait, so
   pull the bar closer to the top edge and shrink the pills a bit
   further to leave more room for the filter bar and pano below it.
   (orientation: landscape) is a genuine viewport-geometry media
   feature (not a device-detection heuristic like hover/pointer), so
   it's safe to combine directly with the touch class here. */
@media (orientation: landscape) {
  html.is-touch-device #plotActionBarRoot {
    top: 8px;
  }

  html.is-touch-device .plot-action-pill {
    padding: 6px 12px 6px 6px;
    font-size: 12px;
  }

  html.is-touch-device .plot-action-icon {
    width: 20px;
    height: 20px;
  }

  html.is-touch-device .plot-action-icon svg {
    width: 17px;
    height: 17px;
  }
}